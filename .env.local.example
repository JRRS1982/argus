# Leave these unset to run Argus in demo mode with fabricated data.
# GitHub is the live provider. Needs read access to the organisation's repositories,
# pull requests and members.
GITHUB_TOKEN=your_github_token
# GITHUB_ORG=mvfglobal            # optional: organisation to discover (default mvfglobal)
# ARGUS_DB_PATH=data/argus.sqlite # optional: override the local cache location

# Argus uses the same token you do, so a refresh never spends the whole hourly
# allowance. Raise the reserve if you want more headroom for your own work; raise the
# per-run cap to finish a backfill in fewer runs.
# GITHUB_RATE_LIMIT_RESERVE=1000     # requests always left for your own GitHub use
# GITHUB_MAX_REQUESTS_PER_RUN=3000   # most any one refresh may spend
# GITHUB_MIN_REQUEST_INTERVAL_MS=50  # pacing, to stay clear of secondary rate limits

# Bitbucket is a frozen, read-only archive: it is never fetched or discovered, so no
# credentials are needed. Its history lives in the SQLite cache.
